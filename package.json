{
  "name": "flykey",
  "version": "0.1.0",
  "private": true,
  "description": "FlyKey touch typing trainer",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron-forge start",
    "desktop": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "package:mac": "electron-forge package --platform=darwin",
    "make:mac": "electron-forge make --platform=darwin",
    "package:mas": "FLYKEY_BUILD_TARGET=mas electron-forge package --platform=mas",
    "make:mas": "FLYKEY_BUILD_TARGET=mas electron-forge make --platform=mas",
    "server": "node server/server.js",
    "server:check": "node --check server/server.js",
    "server:smoke": "node scripts/smoke-server-api.js",
    "backend:smoke": "node scripts/smoke-backend-api.js",
    "content:build": "node scripts/build-content-bundle.js",
    "content:validate": "node scripts/validate-content-bundle.js",
    "storyboard:apply": "node scripts/apply-storyboard.js",
    "check:html": "sh scripts/check-index-html-js.sh",
    "check:cyrillic-ui": "sh scripts/check-cyrillic-ui.sh",
    "check:homepage-localization": "node scripts/check-homepage-localization.js",
    "check:index-fallback-localization": "node scripts/check-index-fallback-localization.js",
    "check:index-single-ui-source": "node scripts/check-index-single-ui-source.js",
    "check:ui-text-parity": "node scripts/check-ui-text-parity.js",
    "check:ui-language-leaks": "node scripts/check-ui-language-leaks.js",
    "check:content-language-leaks": "node scripts/check-content-language-leaks.js",
    "check:no-raw-ui-errors": "node scripts/check-no-raw-ui-errors.js",
    "check:mas-readiness": "node scripts/check-mas-readiness.js",
    "check:js": "find app practice-content desktop scripts server -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run content:validate && npm run check:html && npm run check:cyrillic-ui && npm run check:homepage-localization && npm run check:index-fallback-localization && npm run check:index-single-ui-source && npm run check:ui-text-parity && npm run check:ui-language-leaks && npm run check:content-language-leaks && npm run check:no-raw-ui-errors && npm run check:mas-readiness && npm run check:js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-dmg": "^7.0.0",
    "@electron-forge/maker-pkg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.0.0",
    "electron": "^36.0.0"
  },
  "author": "Sergey Telegin",
  "license": "UNLICENSED"
}
